{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "루틴 작업은 프롬프트 없이, 되돌리기 어렵거나 보안에 닿는 건 확인. 원칙: allow에 없으면 물어본다(deny 패턴 매칭에 안전을 의존하지 않는다). 파일 내용을 임의 경로로 옮기거나 찍을 수 있는 쉘 명령(cat/head/tail/grep/node/cp/mv/tee/echo)은 Read()·Edit() deny를 우회하므로 allow에 두지 않는다 — Read/Grep/Edit 툴을 쓴다.",

  "//limits": "이 규칙은 '협조적인 에이전트의 사고(事故)'를 막는 장치이지 샌드박스가 아니다. 쉘 접근이 있는 한 우회 경로는 원리적으로 남는다(예: npm run 스크립트 경유). 진짜 경계는 (1) .env.local 등 시크릿을 .gitignore로 커밋 대상에서 제외, (2) git push / main 체크아웃을 사람이 확인, (3) 시크릿은 저장소에 두지 않는 것.",

  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "WebFetch",
      "WebSearch",
      "Skill",

      "mcp__claude-in-chrome",
      "mcp__context7",
      "mcp__filesystem",
      "mcp__git",
      "mcp__everything-search",

      "Bash(cd *)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(sleep *)",
      "Bash(netstat *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",

      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm install --save-dev *)",
      "Bash(npm install -D *)",
      "Bash(npm ci*)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm audit)",
      "Bash(npx vitest*)",
      "Bash(npx vite*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree list*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git merge --ff-only*)",
      "Bash(git merge --no-ff*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git switch dev)",
      "Bash(git switch feat/*)",
      "Bash(git switch feature/*)",
      "Bash(git switch loy98/*)",

      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],

    "ask": [
      "Bash(git push*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git -C *)",
      "Bash(git config*)",
      "Bash(git remote*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(npm publish*)",
      "Bash(npx wrangler*)",
      "Bash(wrangler*)",
      "Bash(supabase *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(node *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(tee *)",
      "Bash(echo *)",
      "Bash(printf *)",

      "Edit(./package.json)",
      "Edit(./vite.config.js)",
      "Write(./vite.config.js)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./package.json)",
      "Write(./.gitignore)",
      "Write(./.node-version)"
    ],

    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push * +*)",

      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add *-f *)",
      "Bash(git add *--force*)",

      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(**/id_rsa*)",
      "Read(**/*service_role*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Write(./.env.local)",
      "Write(./.env.*.local)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)"
    ]
  }
}
