# Supabase 연결 정보 (Project Settings → Data API / API Keys 에서 복사)
# 로컬 개발: 이 파일을 .env.local 로 복사해 값 채우기
# 배포(Cloudflare Pages): 대시보드 환경변수에 동일 키로 등록
# 주의: anon key는 브라우저에 노출되는 공개 키가 맞음(비밀 아님). 보안은 DB의 RLS가 담당.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
